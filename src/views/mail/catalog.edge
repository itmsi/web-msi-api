
<!DOCTYPE html>
<html lang="en">

<head>
  <meta http-equiv="Content-Type" content="text/html charset=UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cetak Katalog</title>
  <style>
    * {
      font-size: 14px;
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.5;
    }
  </style>
</head>

<body style="max-width: 600px; margin: 30px auto;">
  <table style="width:100%">
    <tr>
      <td><img src="{{data.LOGO}}" style="width: 100px;" alt="logo"></td>
      <td align="right" style="font-size: 20px; font-weight: bold;">Universal Collection</td>
    </tr>
  </table>
  <p>{{ data.cover_title }} </p>
  <p>
    <table>
      <tr>
        <td width="150px">Nama Lelang</td>
        <td>: {{data.auction_name}}</td>
      </tr>
      <tr>
        <td>Tanggal Lelang</td>
        <td>: {{data.auction_start_date}}</td>
      </tr>
      <tr>
        <td>Nama Lokasi</td>
        <td>: {{data.location_name}}</td>
      </tr>
    </table>
  </p>
  
  
  <p>Salam hangat,<br />Universal Collection</p>
  <br /><br />
  <p style="font-size: 12px; color: #999; text-align: center;">Untuk
    informasi lebih lanjut silahkan menghubungi<br />
    {{data.EMAIL_CS}} atau {{data.PHONE_CS}}</p>
</body>

</html>