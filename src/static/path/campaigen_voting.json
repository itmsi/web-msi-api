{
  "/campaigen-voting": {
    "get": {
      "tags": [
        "Campaigen Voting"
      ],
      "security": [
        { "bearerAuth": [] }
      ],
      "parameters": [
        { "in": "query", "name": "limit", "required": false, "schema": { "type": "integer" }, "description": "Limit pagination" },
        { "in": "query", "name": "page", "required": false, "schema": { "type": "number" }, "description": "Page pagination" },
        { "in": "query", "name": "direction", "required": false, "schema": { "type": "array or string" }, "description": "direction field" },
        { "in": "query", "name": "order", "required": false, "schema": { "type": "array or string" }, "description": "order value" },
        { "in": "query", "name": "search", "required": false, "schema": { "type": "string" }, "description": "search by email" }
      ],
      "responses": {
        "200": { 
          "description": "OK", 
          "content": { 
            "application/json": { 
              "schema": { 
                "type": "object",
                "properties": {
                  "status": { "type": "boolean" },
                  "message": { "type": "string" },
                  "data": {
                    "type": "object",
                    "properties": {
                      "result": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "campaigen_voting_id": { "type": "string", "format": "uuid" },
                            "email_employee_id": { "type": "string", "format": "uuid" },
                            "campaigen_voting_email": { "type": "string" },
                            "campaign_participant_id": { "type": "string", "format": "uuid" },
                            "campaigen_voting_description": { "type": "string" },
                            "created_at": { "type": "string", "format": "date-time" },
                            "created_by": { "type": "string", "format": "uuid" },
                            "updated_at": { "type": "string", "format": "date-time" },
                            "updated_by": { "type": "string", "format": "uuid" },
                            "deleted_at": { "type": "string", "format": "date-time" },
                            "deleted_by": { "type": "string", "format": "uuid" },
                            "email_employee": { "type": "string" },
                            "vote_count": { "type": "integer", "description": "Jumlah vote yang diperoleh participant ini (unique email)" }
                          }
                        }
                      },
                      "count": { "type": "integer" },
                      "total_votes": { "type": "integer", "description": "Total unique voters" }
                    }
                  }
                }
              } 
            } 
          } 
        } 
      }
    },
    "post": {
      "tags": [
        "Campaigen Voting"
      ],
      "security": [
        { "bearerAuth": [] }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/SchemaPostCampaigenVoting" } }
        }
      },
      "responses": {
        "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SchemaResponse" } } } }
      }
    }
  },
  "/campaigen-voting/stats": {
    "get": {
      "tags": [
        "Campaigen Voting"
      ],
      "security": [
        { "bearerAuth": [] }
      ],
      "summary": "Get voting statistics",
      "description": "Get detailed statistics about voting including total votes, participants, and vote distribution",
      "responses": {
        "200": { 
          "description": "OK", 
          "content": { 
            "application/json": { 
              "schema": { 
                "type": "object",
                "properties": {
                  "status": { "type": "boolean" },
                  "message": { "type": "string" },
                  "data": {
                    "type": "object",
                    "properties": {
                      "total_votes": { "type": "integer", "description": "Total unique voters" },
                      "total_participants": { "type": "integer", "description": "Total campaign participants" },
                      "participants_votes": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "campaign_participant_id": { "type": "string", "format": "uuid" },
                            "vote_count": { "type": "integer" },
                            "vote_percentage": { "type": "number" }
                          }
                        }
                      },
                      "summary": {
                        "type": "object",
                        "properties": {
                          "total_unique_voters": { "type": "integer" },
                          "total_campaign_participants": { "type": "integer" },
                          "average_votes_per_participant": { "type": "number" }
                        }
                      }
                    }
                  }
                }
              } 
            } 
          } 
        } 
      }
    }
  },
  "/campaigen-voting/{campaigen_voting_id}": {
    "get": {
      "tags": [
        "Campaigen Voting"
      ],
      "security": [
        { "bearerAuth": [] }
      ],
      "parameters": [
        { "in": "path", "name": "campaigen_voting_id", "required": true, "schema": { "type": "string", "format": "uuid" }, "description": "ID voting" }
      ],
      "responses": {
        "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SchemaResponse" } } } }
      }
    },
    "put": {
      "tags": [
        "Campaigen Voting"
      ],
      "security": [
        { "bearerAuth": [] }
      ],
      "parameters": [
        { "in": "path", "name": "campaigen_voting_id", "required": true, "schema": { "type": "string", "format": "uuid" }, "description": "ID voting" }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/SchemaPutCampaigenVoting" } }
        }
      },
      "responses": {
        "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SchemaResponse" } } } }
      }
    },
    "delete": {
      "tags": [
        "Campaigen Voting"
      ],
      "security": [
        { "bearerAuth": [] }
      ],
      "parameters": [
        { "in": "path", "name": "campaigen_voting_id", "required": true, "schema": { "type": "string", "format": "uuid" }, "description": "ID voting" }
      ],
      "responses": {
        "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SchemaResponse" } } } }
      }
    }
  },
  "/public/voting": {
    "post": {
      "tags": [
        "Public Campaigen Voting"
      ],
      "summary": "Submit vote (email + participant)",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/SchemaPostCampaigenVoting" } }
        }
      },
      "responses": {
        "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SchemaResponse" } } } }
      }
    },
    "get": {
      "tags": [
        "Public Campaigen Voting"
      ],
      "summary": "List voting (group by latest per email)",
      "parameters": [
        { "in": "query", "name": "limit", "required": false, "schema": { "type": "integer" } },
        { "in": "query", "name": "page", "required": false, "schema": { "type": "number" } },
        { "in": "query", "name": "direction", "required": false, "schema": { "type": "array or string" } },
        { "in": "query", "name": "order", "required": false, "schema": { "type": "array or string" } },
        { "in": "query", "name": "search", "required": false, "schema": { "type": "string" } }
      ],
      "responses": {
        "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SchemaPaginationResponse" } } } }
      }
    }
  }
  ,
  "/public/voting/participants": {
    "get": {
      "tags": [
        "Public Campaigen Voting"
      ],
      "summary": "List participants with vote percentage",
      "parameters": [
        { "in": "query", "name": "limit", "required": false, "schema": { "type": "integer" } },
        { "in": "query", "name": "page", "required": false, "schema": { "type": "number" } },
        { "in": "query", "name": "direction", "required": false, "schema": { "type": "array or string" } },
        { "in": "query", "name": "order", "required": false, "schema": { "type": "array or string" } }
      ],
      "responses": {
        "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SchemaPaginationResponse" } } } }
      }
    }
  }
}

