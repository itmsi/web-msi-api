				{
					"bearerAuth": []
				}
			],
			"parameters": [
				{
					"in": "path",
					"name": "email_employee_id",
					"required": true,
					"schema": {
						"type": "string",
						"format": "uuid"
					},
					"description": "Email employee ID"
				}
			],
			"responses": {
				"200": {
					"description": "OK",
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/SchemaResponse"
							}
